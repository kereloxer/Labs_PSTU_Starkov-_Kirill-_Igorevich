#include <iostream>
#include <vector>
#include <cstdlib>
#include <ctime>
#include <cmath>
#include <iomanip>

using namespace std;

// Функция для печати массива
void printArray(const vector<int>& arr, const string& label) {
    cout << label << " [размер = " << arr.size() << "]:\n";
    if (arr.empty()) {
        cout << "  (массив пуст)\n";
        return;
    }
    for (size_t i = 0; i < arr.size(); ++i) {
        cout << "  Индекс " << setw(2) << i << ": " << setw(3) << arr[i] << "\n";
    }
    cout << "----------------------------------------\n";
}

int main() {
    setlocale(LC_ALL, "Russian");
    
    int n;
    cout << "=== Лабораторная работа № 4. Вариант 4 ===" << endl;
    cout << "Введите начальный размер массива: ";
    if (!(cin >> n) || n <= 0) {
        cout << "Ошибка: введено неверное значение!" << endl;
        return 1;
    }

    // 1) Сформировать одномерный массив целых чисел с помощью ГПСЧ
    srand(static_cast<unsigned int>(time(0)));
    vector<int> M(n);
    for (int i = 0; i < n; ++i) {
        M[i] = rand() % 19 - 9; // случайные числа от -9 до 9
    }

    // 2) Распечатать полученный массив
    cout << "\n1-2) Исходный массив:" << endl;
    printArray(M, "Исходный M");

    // 3) Удалить элементы, индексы которых кратны 3 (0, 3, 6, 9...)
    vector<int> temp;
    for (size_t i = 0; i < M.size(); ++i) {
        if (i % 3 != 0) {
            temp.push_back(M[i]);
        }
    }
    M = temp;

    cout << "3) Массив после удаления элементов с индексами, кратными 3:" << endl;
    printArray(M, "Массив после удаления (i % 3 == 0)");

    // 4) Добавить после каждого отрицательного элемента элемент со значением |M[I-1] + 1|
    vector<int> result;
    for (size_t i = 0; i < M.size(); ++i) {
        result.push_back(M[i]);
        if (M[i] < 0) {
            int prev_val = (i > 0) ? M[i - 1] : 0;
            int new_val = abs(prev_val) + 1;
            result.push_back(new_val);
        }
    }
    M = result;

    // 5) Распечатать полученный массив
    cout << "4-5) Итоговый сформированный массив:" << endl;
    printArray(M, "Итоговый M");

    return 0;
}
