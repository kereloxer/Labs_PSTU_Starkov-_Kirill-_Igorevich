#include <iostream>

using namespace std;

int main() {
    // Установка русской локализации для корректного вывода
    setlocale(LC_ALL, "Russian");

    int sum = 0;

    // Цикл от 21 до 99 включительно (больше 20 и меньше 100)
    for (int i = 21; i < 100; i++) {
        if (i % 3 == 0) {
            sum += i;
        }
    }

    cout << "Сумма целых положительных чисел (>20, <100, кратных 3): " << sum << endl;

    return 0;
}
