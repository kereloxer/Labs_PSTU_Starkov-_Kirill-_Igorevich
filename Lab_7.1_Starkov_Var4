#include <iostream>
#include <iomanip>
#include <locale.h>

using namespace std;

// Структура для представления комплексного числа
struct Complex {
    double real;
    double imag;
};

// Перегруженная функция а) для вычитания целых чисел
int subtract(int a, int b) {
    return a - b;
}

// Дополнительная перегрузка для трех целых чисел (для демонстрации перегрузки)
int subtract(int a, int b, int c) {
    return a - b - c;
}

// Перегруженная функция б) для вычитания комплексных чисел
Complex subtract(Complex c1, Complex c2) {
    Complex result;
    result.real = c1.real - c2.real;
    result.imag = c1.imag - c2.imag;
    return result;
}

int main() {
    setlocale(LC_ALL, "Russian");

    cout << "=== ЛАБОРАТОРНАЯ РАБОТА № 7.1 ===" << endl;
    cout << "Вариант 4: Перегруженные функции для вычитания" << endl << endl;

    // 1. Демонстрация вычитания целых чисел
    int x = 45, y = 18;
    cout << "1. Вычитание целых чисел:" << endl;
    cout << "   Исходные числа: a = " << x << ", b = " << y << endl;
    cout << "   Результат subtract(a, b) = " << subtract(x, y) << endl;

    int z = 10;
    cout << "   Троекратное вычитание subtract(" << x << ", " << y << ", " << z << ") = " << subtract(x, y, z) << endl << endl;

    // 2. Демонстрация вычитания комплексных чисел
    Complex num1 = {12.5, 7.3};
    Complex num2 = {4.2, 3.1};
    Complex res = subtract(num1, num2);

    cout << "2. Вычитание комплексных чисел:" << endl;
    cout << "   Первое комплексное число:  " << num1.real << " + " << num1.imag << "i" << endl;
    cout << "   Второе комплексное число:  " << num2.real << " + " << num2.imag << "i" << endl;
    cout << "   Результат вычитания:       " << res.real << " + " << res.imag << "i" << endl;

    return 0;
}
