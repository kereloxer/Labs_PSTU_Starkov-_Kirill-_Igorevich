#include <iostream>
#include <cmath>
#include <iomanip>

using namespace std;

int main() {
    // Настройка локализации и вывода
    setlocale(LC_ALL, "Russian");
    
    // Входные параметры по варианту №4
    const double a = 0.1;       // Начало интервала
    const double b = 0.8;       // Конец интервала
    const double h = 0.1;       // Шаг изменения аргумента
    const int n = 10;           // Число членов степенного ряда

    // Заголовок таблицы
    cout << "===================================================================" << endl;
    cout << "  Лабораторная работа №3. Разложение функции в степенной ряд" << endl;
    cout << "  Выполнил: Старков К.И., группа РИС-26-2б" << endl;
    cout << "  Вариант №4: y = x*arctan(x) - ln(sqrt(1 + x^2))" << endl;
    cout << "===================================================================" << endl;
    cout << setw(8) << "x" << " | "
         << setw(16) << "Точное y(x)" << " | "
         << setw(16) << "Сумма ряда S(x)" << " | "
         << setw(18) << "Отклонение |y-S|" << endl;
    cout << "-------------------------------------------------------------------" << endl;

    // Цикл табулирования по x
    for (double x = a; x <= b + h / 2.0; x += h) {
        // 1. Точное значение функции
        double y = x * atan(x) - log(sqrt(1.0 + x * x));

        // 2. Вычисление суммы степенного ряда S(x)
        double S = 0.0;
        for (int k = 1; k <= n; ++k) {
            double term = pow(-1.0, k + 1) * pow(x, 2 * k) / (2 * k * (2 * k - 1));
            S += term;
        }

        // 3. Вычисление абсолютной погрешности
        double diff = abs(y - S);

        // Форматированный вывод строки таблицы
        cout << fixed << setprecision(1) << setw(8) << x << " | "
             << setprecision(6) << setw(16) << y << " | "
             << setprecision(6) << setw(16) << S << " | "
             << scientific << setprecision(2) << setw(18) << diff << endl;
    }

    cout << "-------------------------------------------------------------------" << endl;
    cout << "Расчет успешно завершен." << endl;

    return 0;
}
